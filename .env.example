# Copy to .env and fill in. Never commit .env.

NEXUSGATE_ENV=dev
NEXUSGATE_LOG_LEVEL=INFO
NEXUSGATE_REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUSGATE_ADMIN_TOKEN=change-me-admin-token
NEXUSGATE_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# Semantic cache
NEXUSGATE_CACHE_SIMILARITY_THRESHOLD=0.92
NEXUSGATE_CACHE_INDEX_BACKEND=bruteforce      # redisearch when running redis-stack
NEXUSGATE_EMBEDDING_BACKEND=hash              # fastembed for real semantic matching (cache + RAG)
NEXUSGATE_MODEL_THREADS=4                     # ONNX threads per model

# RAG
NEXUSGATE_QDRANT_URL=:memory:                 # in-process Qdrant; http://localhost:6333 for a server
NEXUSGATE_QDRANT_API_KEY=
NEXUSGATE_RAG_CHUNKER=structured              # fixed | sentence | structured (see eval/README.md)
NEXUSGATE_RAG_RERANKER=none                   # cross-encoder needs `pip install -e .[embeddings]`

# Background ingestion jobs
NEXUSGATE_WORKER_MODE=inline                  # celery when a worker is running; inline runs in-process
NEXUSGATE_CELERY_BROKER_URL=                  # defaults to NEXUSGATE_REDIS_URL
NEXUSGATE_JOB_MAX_ATTEMPTS=3
NEXUSGATE_JOB_RETRY_BACKOFF_SECONDS=2.0

# Provider credentials (read directly by LiteLLM)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
