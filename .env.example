# Copy to .env and fill in. Never commit .env.

NEXUSGATE_ENV=dev
NEXUSGATE_LOG_LEVEL=INFO
NEXUSGATE_REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUSGATE_ADMIN_TOKEN=change-me-admin-token
NEXUSGATE_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# Semantic cache
NEXUSGATE_CACHE_SIMILARITY_THRESHOLD=0.92
NEXUSGATE_CACHE_INDEX_BACKEND=bruteforce      # redisearch when running redis-stack
NEXUSGATE_EMBEDDING_BACKEND=hash              # fastembed for real semantic matching (cache + RAG)
NEXUSGATE_MODEL_THREADS=4                     # ONNX threads per model
NEXUSGATE_EMBED_BATCH_SIZE=32                 # chunks per batch; bounds memory on a big document
# Bounded inference (see loadtest/README.md): concurrent runs per model, queue before shedding
NEXUSGATE_EMBED_MAX_CONCURRENCY=2
NEXUSGATE_EMBED_MAX_QUEUE=64
NEXUSGATE_RERANK_MAX_CONCURRENCY=2
NEXUSGATE_RERANK_MAX_QUEUE=8
NEXUSGATE_RERANK_MAX_WAIT_MS=250              # skip reranking if it can't start within this

# RAG
NEXUSGATE_QDRANT_URL=:memory:                 # in-process Qdrant; http://localhost:6333 for a server
NEXUSGATE_QDRANT_API_KEY=
NEXUSGATE_RAG_CHUNKER=structured              # fixed | sentence | structured (see eval/README.md)
NEXUSGATE_RAG_RERANKER=none                   # cross-encoder needs `pip install -e .[embeddings]`

# Background ingestion jobs
NEXUSGATE_WORKER_MODE=inline                  # celery when a worker is running; inline runs in-process
NEXUSGATE_CELERY_BROKER_URL=                  # defaults to NEXUSGATE_REDIS_URL
NEXUSGATE_JOB_MAX_ATTEMPTS=3
NEXUSGATE_JOB_RETRY_BACKOFF_SECONDS=2.0

# Chaos testing: lets an admin make a deployment fail on demand. Keep off in production.
NEXUSGATE_FAULT_INJECTION_ENABLED=false

# Public demo (Containerfile.demo sets these): one shared rate-limited key, uploads disabled,
# the handbook in NEXUSGATE_DEMO_CORPUS_DIR pre-loaded. Pair it with the offline routes file.
NEXUSGATE_DEMO_MODE=false
NEXUSGATE_DEMO_RATE_LIMIT_CAPACITY=20
NEXUSGATE_DEMO_RATE_LIMIT_REFILL_PER_SEC=0.5
NEXUSGATE_DEMO_CORPUS_DIR=eval/corpus
# NEXUSGATE_ROUTES_FILE=config/routes.demo.yaml

# LLM tracing (optional: without both keys the gateway traces nothing)
NEXUSGATE_LANGFUSE_PUBLIC_KEY=
NEXUSGATE_LANGFUSE_SECRET_KEY=
NEXUSGATE_LANGFUSE_HOST=https://cloud.langfuse.com

# Provider credentials (read directly by LiteLLM)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
